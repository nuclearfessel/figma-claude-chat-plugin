{
  "name": "Claude Bridge",
  "id": "claude-bridge-figma-plugin",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma", "figjam", "slides", "dev"],
  "enablePrivatePluginApi": true,
  "permissions": ["teamlibrary"],
  "networkAccess": {
    "allowedDomains": [
      "http://localhost",
      "http://localhost:8722",
      "http://localhost:9223",
      "http://localhost:9224",
      "http://localhost:9225",
      "http://localhost:9226",
      "http://localhost:9227",
      "http://localhost:9228",
      "http://localhost:9229",
      "http://localhost:9230",
      "http://localhost:9231",
      "http://localhost:9232",
      "ws://localhost",
      "ws://localhost:8722",
      "ws://localhost:9223",
      "ws://localhost:9224",
      "ws://localhost:9225",
      "ws://localhost:9226",
      "ws://localhost:9227",
      "ws://localhost:9228",
      "ws://localhost:9229",
      "ws://localhost:9230",
      "ws://localhost:9231",
      "ws://localhost:9232",
      "wss://figma-console-mcp.southleft.com",
      "https://figma-console-mcp.southleft.com"
    ],
    "reasoning": "Connects to a local MCP bridge server (localhost:8722, run alongside the Claude CLI) so Claude can read and edit the open Figma file. Also runs figma-console-mcp's vendored Desktop Bridge plugin (ports 9223-9232, plus its optional cloud relay) in a hidden nested iframe, so its ~140 read/write tools work without a second plugin needing to be open."
  },
  "documentAccess": "dynamic-page"
}
